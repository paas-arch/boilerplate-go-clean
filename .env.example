# Скопируй в .env для локального запуска. Файл в git не попадает.
# На сервере DATABASE_DSN ставит панель: не переименовывай его. API слушает порт 8080.
APP_ENV=local

# Локальная база: make db.up.
DATABASE_DSN=postgres://app:app@localhost:5433/app?sslmode=disable

# Необязательно: адрес Sentry для ошибок.
SENTRY_DSN=
